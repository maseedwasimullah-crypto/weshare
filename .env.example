# Copy this file to ".env" and fill in real values.
# ".env" is ignored by git; never commit real credentials.

# --- Database -------------------------------------------------------------
# SQLAlchemy 2.x URL for the application database.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/weshare

# --- Application secrets --------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters or the API refuses to start.
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# --- Session --------------------------------------------------------------
ACCESS_TOKEN_MINUTES=30

# --- Frontend / CORS ------------------------------------------------------
# Exact origin of the deployed frontend, no trailing slash.
# Several origins can be listed separated by commas.
FRONTEND_ORIGIN=http://localhost:5173

# Optional regular expression for preview deployments, for example
# https://weshare-.*\.vercel\.app . Leave empty for an exact-origin policy.
FRONTEND_ORIGIN_REGEX=

# Set to true when serving over HTTPS so the session cookie is secure.
COOKIE_SECURE=false

# --- Email verification (SMTP) --------------------------------------------
# Leave EMAIL_HOST and EMAIL_FROM empty for local development. In that case
# the registration response contains a "verification_token" value so the
# account can still be activated. Configure SMTP for any real deployment.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_USE_TLS=true

# --- Moderation -----------------------------------------------------------
# One disallowed term per line; relative paths resolve from the project root.
MODERATION_BLOCKED_TERMS_FILE=moderation/blocked_terms.txt

# --- Development helpers --------------------------------------------------
# When true and SMTP is not configured, registration returns the verification
# token. Keep false in production.
DEV_VERIFICATION_TOKENS=true
