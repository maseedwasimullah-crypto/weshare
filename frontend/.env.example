# Frontend build-time configuration.
# Copy to ".env.local" for local overrides. ".env.local" is ignored by git.

# Absolute origin of the deployed FastAPI backend, without a trailing slash.
#
# Leave this EMPTY for local development: the browser then calls the relative
# path "/api", which the Vite dev server proxies to http://localhost:8000.
#
# Set it in production, for example:
#   VITE_API_URL=https://weshare-api.onrender.com
#
# Vite inlines VITE_ variables at BUILD time, so changing this value requires
# rebuilding and redeploying the frontend.
VITE_API_URL=

# Override the dev-server proxy target (default http://localhost:8000).
# VITE_API_TARGET=http://localhost:8000
